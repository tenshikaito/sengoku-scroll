{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Strategy": {
    "DefaultScenarioId": "mini_kanto",
    "Multiplayer": {
      "ConnectionLeaseSeconds": 90,
      "PersistenceEnabled": true,
      "StoragePath": "App_Data/multiplayer-rooms"
    },
    "DayDebug": {
      "Enabled": true,
      "WriteToFile": true,
      "OutputDirectory": "Log/strategy-debug",
      "MaxInMemoryEntries": 4000
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- build.cmd 发布时传入 /p:EmbedWebClient=true，将 wwwroot 编入程序集而非输出目录 -->
  <PropertyGroup Condition="'$(EmbedWebClient)' == 'true'">
    <DisableStaticWebAssets>true</DisableStaticWebAssets>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedWebClient)' == 'true' and '$(WebClientDist)' == ''">
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Remove="wwwroot\**\*" />
    <None Remove="wwwroot\**\*" />
  </ItemGroup>

  <!-- Publish directly from dist: never delete/replace a developer's wwwroot. -->
  <ItemGroup Condition="'$(EmbedWebClient)' == 'true' and '$(WebClientDist)' != ''">
    <Content Remove="wwwroot\**\*" />
    <None Remove="wwwroot\**\*" />
    <EmbeddedResource Include="$(WebClientDist)\**\*">
      <Link>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SengokuScroll.Application\SengokuScroll.Application.csproj" />
    <ProjectReference Include="..\SengokuScroll.Domain\SengokuScroll.Domain.csproj" />
    <ProjectReference Include="..\SengokuScroll.Strategy\SengokuScroll.Strategy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\SengokuScroll.Strategy\Maps\mini_kanto.json" Link="Maps\mini_kanto.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
